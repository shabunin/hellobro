# Launch hellobro (the terminal) from NickelMenu.
# cmd_output keeps Nickel waiting while launch.sh freezes it. Its 10 s
# limit runs out while Nickel is frozen, but launch.sh has exited by the
# time Nickel wakes up, so Nickel finds it done. Then Nickel switches views,
# which repaints over whatever the app left on screen.
menu_item : main : Hello Bro : cmd_output : 9999 : quiet : exec /bin/sh /mnt/onboard/.adds/hellobro/launch.sh hellobro
chain_always : nickel_open : library : library
chain_always : nickel_misc : home
