# The PC's side of the relay (README, "From afar"): keeps this PC's sshd
# reachable as 127.0.0.1:2222 on the VPS, for the Kobo's "home" host.
# Put in your VPS address, then:
#   cp hellobro-tunnel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now hellobro-tunnel
#   loginctl enable-linger $USER     # up from boot, logged in or not
[Unit]
Description=hellobro relay: this PC's sshd through the VPS
After=network-online.target
Wants=network-online.target

[Service]
# Edit relay@VPS_ADDRESS: the VPS's address, and the user the relay uses there.
ExecStart=/usr/bin/ssh -N -T \
	-o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
	-o ExitOnForwardFailure=yes -o BatchMode=yes \
	-R 127.0.0.1:2222:127.0.0.1:22 \
	relay@VPS_ADDRESS
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
